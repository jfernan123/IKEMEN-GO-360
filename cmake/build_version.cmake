# Writes OUT, a .cpp with the version text the game shows (m360::buildVersion), run on every build.
# publish_360.bat sets MUGEN360_VERSION to the release's stamp (the tag is xbox-<stamp>); any other build is
# "DEV <date> <commit>". OUT is only rewritten when the text changes, so an unchanged version recompiles nothing.
set(version "$ENV{MUGEN360_VERSION}")
execute_process(COMMAND git rev-parse --short HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
	OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT commit)
	set(commit "NOGIT")
endif()
if(version)
	set(version "V${version} ${commit}")
else()
	string(TIMESTAMP today "%Y.%m.%d")
	set(version "DEV ${today} ${commit}")
endif()
string(TOUPPER "${version}" version)
set(text "// Generated by cmake/build_version.cmake on every build: don't edit.\nnamespace m360 {\nconst char *buildVersion() { return \"${version}\"; }\n}\n")
set(old "")
if(EXISTS "${OUT}")
	file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
	file(WRITE "${OUT}" "${text}")
endif()
